# Environment variables for gatewaySvc

# Replace these development secrets before deploying.
EXTERNAL_IDENTITY_SECRET=dev-secret-change-me
INTERNAL_IDENTITY_SECRET=internal-secret-change-me

# Local service endpoints.
PERSISTENCE_HTTP_URL=http://localhost:9000
MATCHING_HTTP_URL=http://localhost:9003
AUTHEN_HTTP_URL=http://localhost:9001
PARSING_HTTP_URL=http://localhost:9002

# Semicolon-separated list of allowed browser origins.
CORS_ALLOW_ORIGINS=http://localhost:5173;http://localhost:3000
